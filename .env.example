# "mock" is safe fictional data. Set "live" only after completing both local
# browser sign-ins; it makes read-only requests using the saved sessions.
DATA_PROVIDER=mock

# Optional: keep browser login sessions outside the repository. The default is
# ~/.waterloo-study-mcp. Treat this directory like a password; do not share it.
# STUDY_MCP_STATE_DIR=/absolute/path/to/private/state
